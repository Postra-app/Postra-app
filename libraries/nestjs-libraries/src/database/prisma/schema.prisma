enum AnnouncementColor {
  INFO
  WARNING
  ERROR
}

model Announcement {
  id          String            @id @default(uuid())
  title       String
  description String
  color       AnnouncementColor @default(INFO)
  createdAt   DateTime          @default(now())
  // A banner every signed-in session fetches, with no way to stop showing it
  // except an operator remembering to delete it. An outage notice that
  // outlives the outage is worse than none (E2E-09-26).
  expiresAt   DateTime?
  // Soft delete, so the audit row that says who removed it still points at
  // something. Nothing outside the panel ever reads a deleted announcement.
  deletedAt   DateTime?

  @@index([deletedAt, createdAt])
}

// Observational text-AI usage metering (tokens / whisper seconds) per org and
// engine. Scalar organizationId (no relation) to keep this additive and
// isolated — insert-graph rows have no org at all. NOT billing: credit
// limits live in Credits and are untouched by this table.
model AiUsage {
  id             String   @id @default(uuid())
  organizationId String?
  engine         String
  model          String
  unit           String   @default("tokens")
  inputAmount    Int      @default(0)
  outputAmount   Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([engine, createdAt])
}

// Expo push tokens for the Postra Mobile app (companion).
// Cascades on user/org delete so account erasure (RODO art. 17) doesn't leave
// orphaned push tokens behind.
model MobilePushToken {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  token          String       @unique
  platform       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

// Append-only security audit trail (O5): login/impersonation/password/token/
// subscription events. Scalar ids (no relations) so rows survive user/org
// deletion — the trail must outlive its subjects.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  ip             String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// Stripe delivers webhooks at-least-once — it retries for up to 3 days on any
// 5xx or timeout — so a handler running twice would grant a subscription or
// top up credits twice. The webhook claims an event id here before doing any
// work: the row IS the claim, so a redelivery of an id we already finished is
// dropped. A claim whose handler then threw is released, otherwise a transient
// failure would permanently swallow the event on Stripe's retry.
model StripeProcessedEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
