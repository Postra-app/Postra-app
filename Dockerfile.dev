FROM node:22.20-bookworm-slim
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
# Source map upload is a build-time step: without these three the Sentry
# plugin silently uploads nothing and every frontend stack trace stays
# minified. Absent values keep the old behaviour, so the build never breaks.
ARG SENTRY_ORG
ARG SENTRY_PROJECT
ARG SENTRY_AUTH_TOKEN
ENV SENTRY_ORG=$SENTRY_ORG
ENV SENTRY_PROJECT=$SENTRY_PROJECT
ENV SENTRY_AUTH_TOKEN=$SENTRY_AUTH_TOKEN
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
    ffmpeg \
&& rm -rf /var/lib/apt/lists/*

# Amazon's RDS root CAs for eu-west-2, added to Node's trust store.
#
# Node carries its own compiled-in Mozilla roots and ignores the system bundle,
# and Amazon's RDS CA is not in that set. Prisma does not care — its Postgres
# connector is Rust and has its own TLS — but @mastra/pg goes through Node's
# `pg`, whose current default resolves sslmode to verify-full. Without these
# roots that connection dies with "self-signed certificate in certificate
# chain" at boot, which is exactly what NODE_TLS_REJECT_UNAUTHORIZED=0 had been
# hiding on the box (e2e/bugs.md E2E-01-21).
#
# NODE_EXTRA_CA_CERTS *adds* to the built-in roots rather than replacing them,
# so public HTTPS keeps verifying normally. The bundle is vendored rather than
# fetched at build time: it is trust material, so it should be reviewable in a
# diff and identical between builds. Refresh from
# https://truststore.pki.rds.amazonaws.com/eu-west-2/eu-west-2-bundle.pem when
# AWS rotates its RDS CAs.
COPY var/docker/rds-ca-eu-west-2.pem /etc/ssl/rds/eu-west-2-bundle.pem
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/rds/eu-west-2-bundle.pem

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www /var/cache/nginx /var/log/nginx /uploads \
 && chown -R www:www /www /var/lib/nginx /var/log/nginx /var/cache/nginx /uploads


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install

# Install the Geist brand font into fontconfig so the server-side design
# renderer (sharp/librsvg, DESIGN_TEXT_FONT = 'Geist, sans-serif') draws post
# text in Geist instead of a fallback sans. The `geist` npm package (a frontend
# dep) ships the .ttf files; copy from wherever pnpm resolved them.
RUN apt-get update && apt-get install -y --no-install-recommends fontconfig \
 && mkdir -p /usr/share/fonts/truetype/geist \
 && for d in $(find /app -type d -path '*/geist/dist/fonts/geist-sans'); do \
      cp "$d"/*.ttf /usr/share/fonts/truetype/geist/ || true; \
    done \
 && fc-cache -f \
 && fc-list | grep -i geist || echo "WARN: Geist not registered in fontconfig" \
 && rm -rf /var/lib/apt/lists/*

RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# Prebuild the maintenance CLI (apps/commands — e.g. `sync-channel-slots` after
# enabling a new platform). It must ship in the image: the prod box is a
# t3.medium and a nest build inside the running container OOMs (2026-07-14).
# Run on prod with:
#   docker compose exec -T app node /app/apps/commands/dist/apps/commands/src/main.js <command>
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run commands:build:development

RUN chown -R www:www /app

USER www

CMD ["sh", "-c", "nginx && pnpm run pm2"]
