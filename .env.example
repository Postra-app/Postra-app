# Example environment for local development. Copy to .env; every value here is
# a placeholder, never a real key.

# === Required Settings
DATABASE_URL="postgresql://postra-user:postra-password@localhost:5432/postra-db-local"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"
# Encrypts channel tokens and other secrets in the database: "kid:secret",
# secret at least 32 random characters. Rotation: put a new pair first, keep
# the old one after a comma until the backend has re-encrypted every row.
# Unset, the key is derived from JWT_SECRET.
TOKEN_ENCRYPTION_KEYS=""

# === This needs to be exactly the URL you're accessing Postra on
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"
# Public site URL (CORS allow-list + email links), usually same as FRONTEND_URL. Checked at startup.
MAIN_URL="http://localhost:4200"

# === Temporal (scheduler) and background jobs. Defaults match `make infra`.
#TEMPORAL_ADDRESS="localhost:7233"
#TEMPORAL_NAMESPACE="default"
## Temporal Cloud only.
#TEMPORAL_TLS="true"
#TEMPORAL_API_KEY=""
## Backend starts the hourly missed-post sweep and the daily housekeeping
## workflows. Any non-empty value turns it on (even "false"); unset = off.
#RUN_CRON="true"
## Backend Prometheus /metrics (internal port) and orchestrator health server.
#METRICS_PORT="9465"
#ORCHESTRATOR_PORT="3002"

## Cloudflare R2 storage, used only when STORAGE_PROVIDER=cloudflare (production
## uses s3). If the R2 API token has an IP allow-list, add your public IP to it.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY="your-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_BUCKETNAME="your-bucket-name"
CLOUDFLARE_BUCKET_URL="https://your-bucket-url.r2.cloudflarestorage.com/"
CLOUDFLARE_REGION="auto"

# === Common optional Settings

## Email. EMAIL_PROVIDER picks the sender: "resend", "nodemailer" (any SMTP
## server; production uses Amazon SES SMTP) or unset (no email is sent).
## With a provider set, email/password sign-ups must activate their account
## from the email; without one they are activated straight away.
#EMAIL_PROVIDER="nodemailer"
## Resend (EMAIL_PROVIDER=resend). This is a dummy key, create your own.
#RESEND_API_KEY="RzeTwHijvxvPUerScFcenUZUALuQJzSaGSMJ"
## SMTP (EMAIL_PROVIDER=nodemailer). EMAIL_SECURE="true" = TLS on connect (port 465).
#EMAIL_HOST="smtp.example.com"
#EMAIL_PORT="465"
#EMAIL_SECURE="true"
#EMAIL_USER=""
#EMAIL_PASS=""
## Sender of every email. Nothing is sent while either one is missing.
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""
## Monitored inbox for operator notifications (e.g. cancellation feedback).
#EMAIL_ADMIN_ADDRESS=""
#DISABLE_REGISTRATION=false

# Where will social media icons be saved - local, cloudflare, or s3.
STORAGE_PROVIDER="local"

# Your upload directory path if you host your files locally, otherwise Cloudflare/S3 will be used.
#UPLOAD_DIRECTORY=""

# AWS S3 storage (when STORAGE_PROVIDER=s3). On EC2 with an instance role,
# access keys are optional — the default credential chain is used.
#S3_BUCKET=""
#S3_REGION="eu-west-2"
#S3_ACCESS_KEY_ID=""
#S3_SECRET_ACCESS_KEY=""

# Public base URL of uploaded media. With STORAGE_PROVIDER=s3 this is the CDN in
# front of the bucket.
#NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# Social Media API Settings
X_URL=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Separate LinkedIn app providing only the Community Management API,
# used by the "linkedin-page" provider to post as a company Page.
LINKEDIN_PAGE_CLIENT_ID=""
LINKEDIN_PAGE_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
BEEHIIVE_API_KEY=""
BEEHIIVE_PUBLICATION_ID=""
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
# Unset = https://api.pinterest.com. A Trial app creates Pins only on
# https://api-sandbox.pinterest.com (the Standard access film).
PINTEREST_API_BASE=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# Chrome Extension Settings (for cookie-based platform integrations like Skool)
EXTENSION_ID=""

# Misc Settings
OPENAI_API_KEY=""
NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_POLOTNO=""
# NOT_SECURED=false
API_LIMIT=30 # The limit of the public API hour limit

# Set NODE_ENV=production in production. Otherwise analytics caches drop to ~1s TTL
# (extra social-API calls) and Sentry mislabels the environment.
#NODE_ENV="production"

# Plausible analytics in the app (cookieless, no personal data). The site's
# script id from Plausible → Site settings → Installation, e.g. pa-xxxx. Unset
# = no analytics. Public: it ships in the page.
#PLAUSIBLE_SCRIPT_ID=""

# Sentry error tracking (one DSN enables FE + BE; everything is a no-op without it).
# The DSN is public — it ships in the client bundle — so it is NOT a secret.
#NEXT_PUBLIC_SENTRY_DSN=""
# Optional: override trace sampling (defaults: 0.1 in prod, 1.0 in dev).
#SENTRY_TRACES_SAMPLE_RATE="0.1"
# Optional: source-map upload at build time for readable stack traces.
#SENTRY_ORG=""
#SENTRY_PROJECT=""
#SENTRY_AUTH_TOKEN=""
# Key for POST /public/agent, which files a text into the shared "popular posts"
# pool through an AI graph. Unset = the endpoint ignores every call. AutoPost
# does not use it.
#AGENT_API_KEY=""
# Pixabay stock video/image search in Studio.
#PIXABAY_API_KEY=""

# Payment settings
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""

# Developer Settings
NX_ADD_PLUGINS=false
IS_GENERAL="true" # required for now
NEXT_PUBLIC_POSTRA_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_POSTRA_OAUTH_LOGO_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png"
POSTRA_GENERIC_OAUTH="false"
POSTRA_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
POSTRA_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
POSTRA_OAUTH_USERINFO_URL="https://authentik.example.com/application/o/userinfo"
POSTRA_OAUTH_CLIENT_ID=""
POSTRA_OAUTH_CLIENT_SECRET=""

# Short Link Service Settings
# DUB_TOKEN="" # Your self-hosted Dub API token
# DUB_API_ENDPOINT="https://api.dub.co" # Your self-hosted Dub API endpoint
# DUB_SHORT_LINK_DOMAIN="dub.sh" # Your self-hosted Dub domain
# DUB_ANALYTICS="true" # Dub partner analytics script on every app page (off by default; needs consent)

# SHORT_IO_SECRET_KEY="" # Your Short.io API secret key

# KUTT_API_KEY="" # Your Kutt.it API key
# KUTT_API_ENDPOINT="https://kutt.it/api/v2" # Your self-hosted Kutt API endpoint
# KUTT_SHORT_LINK_DOMAIN="kutt.it" # Your self-hosted Kutt domain

# LINK_DRIP_API_KEY="" # Your LinkDrip API key
# LINK_DRIP_API_ENDPOINT="https://api.linkdrip.com/v1/" # Your self-hosted LinkDrip API endpoint
# LINK_DRIP_SHORT_LINK_DOMAIN="dripl.ink" # Your self-hosted LinkDrip domain

# === Settings the code reads that this file did not list. All optional.

## Database: root CA of the server certificate (verify it, not just encrypt)
## and the Prisma pool size per process (default 5).
# DATABASE_CA_FILE="/etc/ssl/rds/eu-west-2-rsa2048-g1.pem"
# DATABASE_CONNECTION_LIMIT="5"
## Backend port inside the container (default 3000).
# PORT="3000"
## Backend URL for the frontend's server-side requests (no fallback).
# BACKEND_URL=""
# NEXT_PUBLIC_OVERRIDE_BACKEND_URL=""

## Uploads: further media hosts the app accepts besides its own (the upload
## CDN, FRONTEND_URL), comma-separated, e.g. a second CDN name.
# RESTRICT_UPLOAD_DOMAINS=""
# DISABLE_IMAGE_COMPRESSION=""

## Channels not listed above.
# INSTAGRAM_APP_ID=""            # Instagram without a Facebook Page
# INSTAGRAM_APP_SECRET=""
# TELEGRAM_TOKEN=""
# TELEGRAM_BOT_NAME=""
# GOOGLE_GMB_CLIENT_ID=""        # Google Business Profile
# GOOGLE_GMB_CLIENT_SECRET=""
# TWITCH_CLIENT_ID=""
# TWITCH_CLIENT_SECRET=""
# KICK_CLIENT_ID=""
# KICK_SECRET=""
# NEYNAR_CLIENT_ID=""            # Farcaster
# NEYNAR_SECRET_KEY=""
# MEWE_APP_ID=""
# MEWE_API_KEY=""
# MEWE_HOST=""
# VK_ID=""
# WHOP_CLIENT_ID=""
# BLUESKY_APPVIEW_URL=""
# DISCORD_API_URL=""
# STRIP_LINKS_FROM_X_POSTS=""
# DISABLE_X_ANALYTICS=""
## Organisations that see providers still in preview (comma-separated ids).
# PREVIEW_ORGANIZATIONS=""

## AI and media.
# AGENT_MODEL=""
# OPENAI_IMAGE_CONCURRENCY=""
# DESIGN_RENDER_CONCURRENCY=""
# FAL_KEY=""
# KIEAI_API_KEY=""               # video generation
# KIEAI_API_URL=""
# ELEVENSLABS_API_KEY=""
# TAVILY_API_KEY=""              # web search for the agent
# PEXELS_API_KEY=""
# PEXELS_API_URL=""
# PEXELS_ASSET_ORIGIN=""
# UNSPLASH_ACCESS_KEY=""
# UNSPLASH_API_URL=""
# UNSPLASH_ASSET_ORIGIN=""
# TRANSLOADIT_AUTH=""
# TRANSLOADIT_SECRET=""
# TRANSLOADIT_TEMPLATE=""
## AI cost report: margin and exchange rate.
# MARGIN_USD_PER_GBP=""

## MCP and OAuth clients.
# MCP_URL=""
# OAUTH_DYNAMIC_REDIRECT_HOSTS=""
# OPENAI_APP_CHALLANGE=""

## Mobile app: deep-link scheme and app-link verification.
# MOBILE_APP_SCHEME=""
# IOS_APP_ID=""
# ANDROID_EXTRA_CERT_FINGERPRINTS=""

## Billing.
# STRIPE_DISCOUNT_ID=""

## Analytics, tracking and newsletter (all off when unset).
# NEXT_PUBLIC_GTM_ID=""
# NEXT_PUBLIC_FACEBOOK_PIXEL=""
# FACEBOOK_PIXEL_ACCESS_TOKEN=""
# NEXT_PUBLIC_TRACKING_TRIAL=""
# DATAFAST_API_KEY=""
# DATAFAST_WEBSITE_ID=""
# LISTMONK_WELCOME_TEMPLATE_ID=""

## Monitoring: admin dashboard metrics from Grafana, Sentry tracing, local Spotlight.
# GRAFANA_URL=""
# GRAFANA_SA_TOKEN=""
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""
# SENTRY_SPOTLIGHT=""

## Enterprise routes (SaaS integrations); off when unset.
# ENABLE_SAAS_INTEGRATION_ROUTES=""
