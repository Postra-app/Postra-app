# Environment for the stack tests. Every value is a local fake: no real
# keys, no real services. Safe to commit.
DATABASE_URL=postgresql://postra:postra@localhost:55432/postra
REDIS_URL=redis://localhost:56379
TEMPORAL_ADDRESS=localhost:57233
JWT_SECRET=stack-tests-only-not-a-secret
BACKEND_PORT=53000
PORT=53000
FRONTEND_URL=http://localhost:54000
NEXT_PUBLIC_BACKEND_URL=http://localhost:54000/api
BACKEND_INTERNAL_URL=http://localhost:53000
MAIN_URL=http://localhost:54000
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/tmp/postra-e2e-stack-uploads
NOT_SECURED=true
IS_GENERAL=true
TZ=UTC
MASTODON_URL=http://localhost:58080
# Bluesky post statistics read the public AppView; the fake answers it.
BLUESKY_APPVIEW_URL=http://localhost:58080
# Discord's API for post statistics (fake-mastodon.mjs answers messages).
DISCORD_API_URL=http://localhost:58080/api
MASTODON_CLIENT_ID=stack-fake
MASTODON_CLIENT_SECRET=stack-fake
# Billing on, like production: plan limits and paywalls apply. A fake key —
# nothing talks to Stripe.
STRIPE_PUBLISHABLE_KEY=pk_test_stack_fake
# The official OpenAI SDK reads OPENAI_BASE_URL: AI calls go to
# fake-openai.mjs, never to OpenAI.
OPENAI_API_KEY=sk-stack-fake
OPENAI_BASE_URL=http://localhost:58090/v1
# Pexels stock (fake-mastodon.mjs answers); the importer may fetch files from
# the fake as well as from Pexels' own hosts.
PEXELS_API_KEY=stack-fake-pexels
PEXELS_API_URL=http://localhost:58080/pexels
PEXELS_ASSET_ORIGIN=http://localhost:58080/__pexels/
# AI video (Veo through kie.ai): the same fake answers, never kie.ai.
KIEAI_API_KEY=stack-fake-kie
KIEAI_API_URL=http://localhost:58090
FACEBOOK_APP_ID=stack-fake-meta-app
